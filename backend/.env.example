# Copia este archivo a backend/.env y ajusta los valores.
# Precedencia: variables de entorno reales > backend/.env > defaults de XAMPP local.
# Si no creas el .env, el backend funciona con los valores por defecto (XAMPP).

# ── Base de datos ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=inventario_db
DB_USER=root
DB_PASS=

# ── CORS ───────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma (sin espacios).
APP_ORIGINS=http://localhost:5173

# ── Avatar (opcional) ──────────────────────────────────────────────────────
# URL de proveedor de avatar. Placeholders: {name} y {size}.
# Vacío = sin avatar externo (el frontend muestra iniciales locales).
AVATAR_URL=
