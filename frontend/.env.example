# Copia este archivo a frontend/.env y ajusta los valores.
# Reinicia `npm run dev` tras cualquier cambio (Vite lee estas variables al arrancar).

# ── Avatar (opcional) ──────────────────────────────────────────────────────
# URL de proveedor de avatar. Placeholders: {name} y {size}.
# Vacío = sin avatar externo (se muestran las iniciales del usuario).
VITE_AVATAR_URL=
